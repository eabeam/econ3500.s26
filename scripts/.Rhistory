#!/usr/bin/env Rscript
# This script downloads the newest ACS 1-year sample from IPUMS USA,
# converts it to a Stata data file, and writes a small .do file that
# loads the dataset for downstream labs.
#
# Requirements:
#   * An IPUMS API key stored in the IPUMS_API_KEY environment variable.
#   * The R packages ipumsr, dplyr, stringr, glue, haven, cli.
library(ipumsr)
library(dplyr)
library(stringr)
library(glue)
library(haven)
library(cli)
api_key <- Sys.getenv("IPUMS_API_KEY")
if (api_key == "") {
stop("Please set your IPUMS_API_KEY environment variable before running this script.")
}
